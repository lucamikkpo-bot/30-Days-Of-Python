# Declare a function named evens_and_odds . It takes a positive integer as parameter and it counts number of evens and odds in the number.


def evens_and_odds(n):
    evens = 0
    odds = 0
    for i in range(n + 1):
        if i % 2 == 0:
            evens += 1
        else:
            odds += 1
    return evens, odds 

